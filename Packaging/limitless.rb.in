cask "limitless" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/leboonducoin/Limitless/releases/download/v#{version}/Limitless-#{version}-arm64.zip"
  name "Limitless"
  desc "Menu bar utility for explicit, protected keep-awake sessions"
  homepage "https://github.com/leboonducoin/Limitless"

  depends_on arch: :arm64
  depends_on macos: :tahoe

  app "Limitless.app"
  binary "#{appdir}/Limitless.app/Contents/MacOS/limitless"

  uninstall quit:   "io.github.leboonducoin.Limitless",
            script: {
              executable:   "#{appdir}/Limitless.app/Contents/MacOS/LimitlessApp",
              args:         ["--prepare-uninstall"],
              must_succeed: true,
              sudo:         false,
            }

  zap trash: [
    "~/Library/Caches/io.github.leboonducoin.Limitless",
    "~/Library/Preferences/io.github.leboonducoin.Limitless.plist",
    "~/Library/Saved Application State/io.github.leboonducoin.Limitless.savedState",
  ]

  caveats <<~EOS
    Open Limitless to approve its helper through macOS.
    Launch at login and automation are separate opt-ins.
    Upgrade and uninstall end all sessions and remove native service registrations.
    An upgrade requires opening Limitless and enabling those integrations again.
    If cleanup fails, keep the app installed and use Prepare for removal in Settings.
  EOS
end
